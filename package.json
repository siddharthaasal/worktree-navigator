{
  "name": "worktree-navigator",
  "displayName": "Worktree Navigator",
  "description": "Visualize and switch Git worktrees from a sidebar.",
  "version": "0.0.1",
  "publisher": "worktree-navigator",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktreeNavigator",
          "title": "Worktrees",
          "icon": "media/worktrees.svg"
        }
      ]
    },
    "views": {
      "worktreeNavigator": [
        {
          "id": "worktreeNavigator.worktrees",
          "name": "Worktrees",
          "icon": "media/worktrees.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "worktreeNavigator.refresh",
        "title": "Refresh Worktrees",
        "icon": "$(refresh)"
      },
      {
        "command": "worktreeNavigator.switch",
        "title": "Switch to Worktree"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "worktreeNavigator.refresh",
          "when": "view == worktreeNavigator.worktrees",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run compile -- --sourcemap --watch",
    "package": "npm run compile -- --minify",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
