{
  "name": "worktree-navigator",
  "displayName": "Worktree Navigator",
  "description": "Visualize and switch Git worktrees from a sidebar.",
  "version": "0.0.1",
  "publisher": "worktree-navigator",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "worktreeNavigator",
          "title": "Worktrees",
          "icon": "media/worktrees.svg"
        }
      ]
    },
    "views": {
      "worktreeNavigator": [
        {
          "id": "worktreeNavigator.pane",
          "type": "webview",
          "name": "Worktrees",
          "icon": "media/worktrees.svg",
          "when": "worktreeNavigator.viewMode == 'pane'"
        },
        {
          "id": "worktreeNavigator.worktrees",
          "name": "Worktrees",
          "icon": "media/worktrees.svg",
          "when": "worktreeNavigator.viewMode == 'tree'"
        }
      ]
    },
    "commands": [
      {
        "command": "worktreeNavigator.refresh",
        "title": "Refresh Worktrees",
        "category": "Worktrees",
        "icon": "$(refresh)"
      },
      {
        "command": "worktreeNavigator.switch",
        "title": "Switch to Worktree",
        "category": "Worktrees"
      },
      {
        "command": "worktreeNavigator.switchMode",
        "title": "Switch View (Tree / Pane)",
        "category": "Worktrees",
        "icon": "$(list-tree)"
      },
      {
        "command": "worktreeNavigator.togglePane",
        "title": "Toggle Worktrees Pane",
        "category": "Worktrees"
      }
    ],
    "keybindings": [
      {
        "command": "worktreeNavigator.togglePane",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "worktreeNavigator.refresh",
          "when": "view == worktreeNavigator.worktrees || view == worktreeNavigator.pane",
          "group": "navigation@1"
        },
        {
          "command": "worktreeNavigator.switchMode",
          "when": "view == worktreeNavigator.worktrees || view == worktreeNavigator.pane",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Worktree Navigator",
      "properties": {
        "worktreeNavigator.viewMode": {
          "type": "string",
          "enum": ["pane", "tree"],
          "enumDescriptions": [
            "Rich webview pane (highlighted active row, colored diff pills).",
            "Lightweight native tree list."
          ],
          "default": "pane",
          "description": "Which Worktrees view to show in the sidebar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run compile -- --sourcemap --watch",
    "package": "npm run compile -- --minify",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
